                </children>
            </HBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.columnSpan="6" GridPane.rowIndex="3" GridPane.rowSpan="5">
                <content>
                    <VBox fx:id="VBoxActivities" spacing="20.0" style="-fx-background-color: TRANSPARENT;">
                        <padding>
                            <Insets left="10.0" right="10.0" />
                        </padding>
