                    <TextField fx:id="txtID" prefHeight="42.0" prefWidth="150.0" promptText="ID" HBox.hgrow="NEVER" />
                    <Button mnemonicParsing="false" onAction="#searchActivity" styleClass="button-primario" text="Buscar" />
                </children>
            </HBox>
            <HBox alignment="BOTTOM_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.columnIndex="5" GridPane.columnSpan="2" GridPane.rowIndex="2">
