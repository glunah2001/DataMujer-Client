<AnchorPane style="-fx-background-color: TRANSPARENT;" stylesheets="@stylesheet/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uned.clientedatamujer.controller.view.VolunteeringUpdateController">
   <GridPane style="-fx-background-color: TRANSPARENT;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <columnConstraints>
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints fillHeight="false" minHeight="10.0" prefHeight="30.0" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      </rowConstraints>
      <children>
         <HBox alignment="CENTER" prefHeight="40.0" prefWidth="880.0" GridPane.columnIndex="2" GridPane.columnSpan="4">
            <children>
               <Label styleClass="etiqueta-mayor" text="Actualizar un Voluntariado" />
            </children>
         </HBox>
         <HBox alignment="CENTER_LEFT" prefHeight="68.0" prefWidth="679.0" style="-fx-background-color: #e0d7cf;" GridPane.columnIndex="1" GridPane.columnSpan="6" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="CENTER" GridPane.vgrow="NEVER">
            <children>
               <Label styleClass="etiqueta-menor" text="Datos de la actividad" />
            </children>
            <padding>
               <Insets left="30.0" />
            </padding>
         </HBox>
         <HBox alignment="CENTER" prefHeight="70.0" prefWidth="780.0" spacing="20.0" GridPane.columnIndex="1" GridPane.columnSpan="6" GridPane.rowIndex="2">
            <children>
               <TextField fx:id="txtID" editable="false" prefWidth="250.0" promptText="ID" HBox.hgrow="ALWAYS" />
               <TextField fx:id="txtUsername" editable="false" prefHeight="42.0" prefWidth="250.0" promptText="USERNAME DEL ORGANIZADOR" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
         <HBox alignment="CENTER" prefHeight="69.0" prefWidth="200.0" spacing="80.0" GridPane.columnIndex="1" GridPane.columnSpan="6" GridPane.rowIndex="5">
            <children>
               <TextField fx:id="txtRole" promptText="ROL" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
         <HBox alignment="CENTER" prefHeight="125.0" prefWidth="780.0" spacing="50.0" GridPane.columnIndex="1" GridPane.columnSpan="6" GridPane.rowIndex="4">
            <children>
               <VBox alignment="CENTER" prefHeight="100.0" prefWidth="325.0" spacing="10.0">
                  <children>
                     <DatePicker fx:id="dtpStartDate" promptText="FECHA INICIO" />
                     <HBox prefHeight="100.0" prefWidth="200.0" styleClass="time-picker">
                        <children>
                           <Spinner fx:id="spinnerStartHour" HBox.hgrow="ALWAYS" />
                           <Spinner fx:id="spinnerStartMinutes" HBox.hgrow="ALWAYS" />
                        </children>
                     </HBox>
                  </children>
               </VBox>
               <VBox alignment="CENTER" prefHeight="200.0" prefWidth="325.0" spacing="10.0">
                  <children>
                     <DatePicker fx:id="dtpEndDate" promptText="FECHA FIN" />
                     <HBox prefHeight="100.0" prefWidth="200.0" styleClass="time-picker">
                        <children>
                           <Spinner fx:id="spinnerEndHour" HBox.hgrow="ALWAYS" />
                           <Spinner fx:id="spinnerEndMinutes" HBox.hgrow="ALWAYS" />
                        </children>
                     </HBox>
                  </children>
               </VBox>
            </children>
         </HBox>
         <HBox alignment="CENTER" prefHeight="53.0" prefWidth="880.0" spacing="20.0" GridPane.columnIndex="1" GridPane.columnSpan="6" GridPane.rowIndex="7">
            <children>
               <Button mnemonicParsing="false" onAction="#update" styleClass="button-primario" text="Actualizar" />
               <Button mnemonicParsing="false" onAction="#reset" styleClass="button-primario" text="Restaurar" />
            </children>
         </HBox>
      </children>
